# Signs session cookies and encrypts Cockpit passwords. If left empty, a random value is generated
# once and kept in data/.secret_key. If it changes, stored Cockpit passwords can no longer be decrypted.
SECRET_KEY=
PORT=7435
# The address the gateway is reached at from outside (for OAuth redirects)
PUBLIC_URL=https://mcp.example.com
# The Cockpit that verifies logins. Default: the host machine the gateway runs on.
COCKPIT_AUTH_URL=https://host.docker.internal:9090
# Whether to verify the Cockpit certificate (leave false if it is self-signed)
COCKPIT_AUTH_VERIFY_TLS=false
# Required: Cockpit users allowed into the gateway (comma separated). The gateway does not start if empty.
ALLOWED_USERS=
# Access token required in addition to the Cockpit login (second factor). If left empty, a random value is
# generated once and kept in data/.mcp_api_key. If added to the MCP address (https://.../mcp?token=...),
# the login page does not ask for it again. If changed, everyone has to log in again.
MCP_API_KEY=
# Addresses of your reverse proxies (comma separated, CIDR allowed). Only these may set X-Forwarded-*.
# With the docker compose network and a proxy on the host, use the bridge range, e.g. 172.16.0.0/12.
TRUSTED_PROXIES=127.0.0.1
# true: MCP clients get read-only tools; commands, updates, reboots and firewall changes are disabled.
MCP_READ_ONLY=false
SSH_LOGINS=root:/root/.ssh
# Optional: default proxy for connections to the servers (Cockpit and SSH).
# The servers see the proxy's IP address instead of the gateway's. Can be changed per server in the panel.
# Example: socks5://10.0.0.1:1080, socks5h://user:password@proxy:1080, http://proxy:3128
OUTBOUND_PROXY=
# Optional: maximum size of the audit log file (data/audit.log), in MB. When full it is rotated to .1.
AUDIT_LOG_MAX_MB=10
